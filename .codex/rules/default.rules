# Project-local git authorization rules for passwd-x.
#
# 仓库所有者已明确授权 Codex 在本项目内执行所有 git 操作，不再逐个提示。
# 注意：这包括可能造成数据丢失或改写远程历史的操作（如 reset --hard、
# clean -f、checkout --、push --force 等），执行前仍会尽量先确认目标。

prefix_rule(
    pattern = ["git"],
    decision = "allow",
    justification = "Repository owner authorized all git operations for this project.",
)
