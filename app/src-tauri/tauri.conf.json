{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "passwd-x",
  "identifier": "com.passwdx.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "passwd-x",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhGQzc0NjE2QzUzQUY0ODUKUldTRjlEckZGa2JIajczaVZ1UXlsK0NPUU1qcnRxNXZKS3JETElCR2ZFSjhldEpCYmR0bTcvZFgK",
      "endpoints": [
        "https://github.com/He1senber9/passwd-x/releases/latest/download/latest.json"
      ]
    }
  }
}
